# LLM
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Database (Postgres with pgvector extension)
DATABASE_URL=postgresql://filinglens:filinglens@localhost:5432/filinglens

# Embedding model (runs locally via sentence-transformers, no API cost)
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# SEC EDGAR — set a real contact email, SEC requires this in the User-Agent
SEC_USER_AGENT="FilingLens research@yourdomain.com"

# Observability (optional — leave blank to disable tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Feature flags
VERIFIER_ENABLED=true
MAX_VERIFY_RETRIES=2
